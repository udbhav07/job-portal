# MongoDB connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
# port the API listens on (the frontend's VITE_API_URL must point here)
PORT=7999
# long random string used to sign login tokens
JWT_SECRET=change-me-to-a-long-random-string
# optional: allowed frontend origin(s), comma-separated; any origin if unset
CLIENT_URL=http://localhost:5173
# set when deployed behind a reverse proxy (Render, Railway, Nginx...):
# the number of proxies in front of the API, usually 1. Leave unset locally.
# TRUST_PROXY=1

# Backblaze B2 bucket for profile pictures, company logos and resumes.
# B2_REGION is the middle part of the endpoint (us-west-004), without "s3."
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET=jobportal-files
B2_KEY_ID=your-keyID
B2_APP_KEY=your-applicationKey
